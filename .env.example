# Ryanair Price Tracker - Environment Variables Configuration
# 
# Copy this file to .env and fill in your own values
# NEVER commit .env to Git (it contains secrets!)
#
# ============================================
# GMAIL EMAIL CONFIGURATION
# ============================================
#
# How to set up Gmail app password:
# 1. Go to myaccount.google.com
# 2. Click "Security" on the left
# 3. Enable "2-Step Verification" if not already enabled
# 4. Scroll down and find "App passwords"
# 5. Generate a new app password (select "Mail" and "Windows Computer")
# 6. Copy the 16-character password and paste it below
#
GMAIL_EMAIL=your-email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
EMAIL_RECIPIENT=your-email@gmail.com

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
#
# How to set up Telegram bot:
# 1. Open Telegram app
# 2. Search for "@BotFather"
# 3. Chat with BotFather and type /newbot
# 4. Give your bot a name (e.g., "RyanairPriceBot")
# 5. Give your bot a username (e.g., "ryanair_price_bot")
# 6. BotFather will give you a TOKEN - copy it below
# 7. Add your bot to a chat group
# 8. Send a message in the group
# 9. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 10. Find your chat ID in the JSON response and copy it below
#
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================
# PRICE THRESHOLD CONFIGURATION
# ============================================
#
# Price in EUR at which you want to be alerted
# If flight price drops below this, you'll get a notification
#
PRICE_THRESHOLD=50.0

# ============================================
# RYANAIR ROUTE CONFIGURATION
# ============================================
#
# Airport IATA codes:
# TLL = Tallinn, Estonia
# NUE = Nuremberg, Germany
#
# You can change these to track different routes
#
DEPARTURE_AIRPORT=TLL
ARRIVAL_AIRPORT=NUE
